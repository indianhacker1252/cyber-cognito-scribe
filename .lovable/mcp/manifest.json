{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://npeiemvldvcdsbeofkfc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cyberscope-ai",
      "version": "0.2.0",
      "title": "CyberScope AI"
    },
    "tools": [
      {
        "name": "list_targets",
        "title": "List scan targets",
        "description": "List the signed-in user's target workspaces (hosts/apps being scanned).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Max targets to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_findings",
        "title": "List vulnerability findings",
        "description": "List vulnerability findings the signed-in user can see, optionally filtered by target or severity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string",
              "format": "uuid",
              "description": "Restrict to one target workspace."
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_finding",
        "title": "Get finding details",
        "description": "Fetch full details (evidence, request/response, remediation) for a single vulnerability finding.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Finding ID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_target",
        "title": "Create scan target",
        "description": "Create a new target workspace to be scanned. Only in-scope, authorized targets should be added.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Target name or primary URL/host."
            },
            "auto_mythos": {
              "type": "boolean",
              "default": false,
              "description": "Automatically run the full Mythos pipeline after creation."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "run_scan",
        "title": "Start a scan",
        "description": "Kick off a new autonomous scan session for a target the signed-in user owns. Returns the agent_session id you can poll with explain_finding / list_findings.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string",
              "format": "uuid",
              "description": "Target to scan (must belong to the caller)."
            },
            "mode": {
              "type": "string",
              "enum": [
                "quick",
                "deep",
                "chain"
              ],
              "default": "deep",
              "description": "quick=recon+top-10, deep=full OWASP, chain=multi-step exploit chains."
            },
            "max_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          },
          "required": [
            "target_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "explain_finding",
        "title": "Explain a finding",
        "description": "Return a human-readable explanation of one vulnerability finding: what it is, the proof oracle verdict, the request/response evidence, and remediation guidance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "finding_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "finding_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_running_agents",
        "title": "List running agent sessions",
        "description": "List the caller's currently queued or running autonomous scan sessions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_completed": {
              "type": "boolean",
              "default": false,
              "description": "Also include completed/failed sessions."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
